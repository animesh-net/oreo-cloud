# Settings for the oreo-cloud Pi, built into the image. Change them through a pull request; the
# Pi picks them up with `docker compose pull && docker compose up -d`. A value set in the Pi's
# .env overrides the one here, so keep .env for the required values and secrets.

# Disks the system check watches (paths inside the containers), and which of them must be a
# mounted drive rather than an empty folder.
OREO_DISK_PATHS=/,/host/mnt/data-hot-ssd1
OREO_MOUNT_PATHS=/host/mnt/data-hot-ssd1

# Alert thresholds. Memory, CPU usage and temperature alert only once they have stayed over
# the limit for their *_SUSTAINED_SECONDS.
OREO_MEMORY_MAX_PERCENT=70
OREO_MEMORY_SUSTAINED_SECONDS=120
OREO_CPU_MAX_PERCENT=50
OREO_CPU_SUSTAINED_SECONDS=120
OREO_TEMPERATURE_MAX_C=55
OREO_TEMPERATURE_SUSTAINED_SECONDS=120
OREO_DISK_MAX_PERCENT=90

# How often a problem that lasts is repeated.
OREO_ALERT_REMINDER_HOURS=1
