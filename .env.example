# Copy to .env on the Pi and fill in. .env is gitignored; never commit it.

# Group that owns /var/run/docker.sock: `stat -c %g /var/run/docker.sock`
DOCKER_GID=

# Shared with oreo-monitor's OREO_HEARTBEAT_TOKEN secret: `openssl rand -hex 32`
OREO_HEARTBEAT_TOKEN=

# ntfy topic for alerts, e.g. https://ntfy.sh/<topic>. Required: the agent will not start without it.
OREO_NTFY_URL=
OREO_NTFY_TOKEN=

# Publish the heartbeat only on the Pi's Tailscale address: `tailscale ip -4`
# Leave empty to listen on every interface.
OREO_BIND_IP=
