# Copy to .env on the Pi and fill in. .env is gitignored; never commit it.

# Group that owns /var/run/docker.sock: `stat -c %g /var/run/docker.sock`
DOCKER_GID=

# Shared with oreo-monitor's OREO_HEARTBEAT_TOKEN secret: `openssl rand -hex 32`
OREO_HEARTBEAT_TOKEN=

# ntfy topic for alerts, e.g. https://ntfy.sh/<topic>. Required: the agent will not start without it.
OREO_NTFY_URL=
OREO_NTFY_TOKEN=

# Required. The heartbeat listens only on this address, the Pi's Tailscale IP: `tailscale ip -4`
OREO_BIND_IP=

# Optional. Uncomment to change a default; anything left commented uses the value shown.
# Image tag; set a sha-<commit> tag to roll back.
# OREO_IMAGE_TAG=latest
# Time zone for alert times and the backup schedule.
# OREO_TIMEZONE=Asia/Kolkata
# Local time of the nightly backup, and how old the last good one may get before an alert.
# OREO_BACKUP_TIME=03:30
# OREO_BACKUP_MAX_AGE_HOURS=26
# Repeat an alert this often while something stays broken.
# OREO_ALERT_REMINDER_HOURS=6
# Drives for `oreo drives`, as label=Name pairs separated by ;
# OREO_DRIVES=nvme-root=System (NVMe | nvme-root);data-hot-ssd1=Data (Hot Tier | data-hot-ssd1)
# Host mount points `oreo storage` requires.
# OREO_STORAGE_MOUNTS=/,/boot/firmware,/mnt/data-hot-ssd1,/mnt/osbackup
# Wi-Fi interface the network watchdog repairs, and the router's daily restart window.
# OREO_NET_INTERFACE=wlan0
# OREO_NET_QUIET_WINDOW=05:55-06:15
# Websites the agent checks, and how many days a certificate must still have.
# OREO_SITES=https://cloud.animesh.org.in/api/server/ping,https://pi.animesh.org.in/
# OREO_CERT_MIN_DAYS=14
# Alert thresholds (memory, CPU, temperature, disk) are set in compose.yaml under x-thresholds,
# not here.
