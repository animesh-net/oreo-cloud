# The Pi's sites, reachable only over Tailscale. {$...} values come from the container's
# environment: OREO_BIND_IP from .env, the rest from proxy.env (never committed).
cloud.animesh.org.in {
	bind {$OREO_BIND_IP}
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
	}
	header Strict-Transport-Security "max-age=15552000"
	reverse_proxy 127.0.0.1:2283
}

pi.animesh.org.in {
	bind {$OREO_BIND_IP}
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
	}
	basic_auth {
		animesh {$PI_AUTH_HASH}
	}
	reverse_proxy 127.0.0.1:34001
}

# oreo-ai's web app, running on this Pi as its own compose project (oreo-ai, in ~/oreo-ai) on
# 127.0.0.1:8080. It signs users in itself (Google or Microsoft, with an allowlist), so there
# is no proxy password. The Pi is always on, so the site always answers and is in the website
# checks. flush_interval -1 passes streamed replies on as they arrive.
ai.animesh.org.in {
	bind {$OREO_BIND_IP}
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
	}
	reverse_proxy 127.0.0.1:8080 {
		flush_interval -1
	}
}
